{"case_id": "buffer-001", "operation": "buffer", "split": "test", "prompt": "Buffer the point at longitude 13.405, latitude 52.52 (WGS 84) by 500 meters. Return the buffer polygon in WGS 84 longitude and latitude (OGC:CRS84).", "inputs": {"files": {}, "params": {"geometry": {"type": "Point", "coordinates": [13.405, 52.52]}, "distance": 500, "units": "m"}}, "expected": "expected/buffer-001.json", "tolerances": {"tol_m": {"value": 5.0, "units": "m"}, "area_tol_rel": {"value": 0.01, "units": "ratio"}}, "strata": {"operation": "buffer", "buffer_kind": "point_geographic", "trap": true}}
{"case_id": "buffer-002", "operation": "buffer", "split": "test", "prompt": "Buffer the line in UTM zone 33N (EPSG:32633) by 25 meters with round caps and joins. Return the polygon in EPSG:32633.", "inputs": {"files": {}, "params": {"geometry": {"type": "LineString", "coordinates": [[390000, 5820000], [390400, 5820300], [390800, 5820100]]}, "source_crs": "EPSG:32633", "distance": 25, "units": "m"}}, "expected": "expected/buffer-002.json", "tolerances": {"tol_m": {"value": 0.25, "units": "m"}, "area_tol_rel": {"value": 0.01, "units": "ratio"}}, "strata": {"operation": "buffer", "buffer_kind": "line", "trap": false}}
{"case_id": "buffer-003", "operation": "buffer", "split": "test", "prompt": "Buffer the 40 m by 40 m square in UTM zone 33N (EPSG:32633) inward by 25 meters (a buffer of -25 m). Return the result in EPSG:32633.", "inputs": {"files": {}, "params": {"geometry": {"type": "Polygon", "coordinates": [[[390000, 5820000], [390040, 5820000], [390040, 5820040], [390000, 5820040], [390000, 5820000]]]}, "source_crs": "EPSG:32633", "distance": -25, "units": "m"}}, "expected": "expected/buffer-003.json", "tolerances": {"tol_m": {"value": 0.01, "units": "m"}, "area_tol_rel": {"value": 0.01, "units": "ratio"}}, "strata": {"operation": "buffer", "buffer_kind": "negative_collapse", "trap": true}}
{"case_id": "buffer-004", "operation": "buffer", "split": "test", "prompt": "Buffer the 100 m line in UTM zone 33N (EPSG:32633) by 10 meters with flat caps (the buffer ends at the line's end points). Return the polygon in EPSG:32633.", "inputs": {"files": {}, "params": {"geometry": {"type": "LineString", "coordinates": [[390000, 5820000], [390100, 5820000]]}, "source_crs": "EPSG:32633", "distance": 10, "units": "m", "cap_style": "flat"}}, "expected": "expected/buffer-004.json", "tolerances": {"tol_m": {"value": 0.1, "units": "m"}, "area_tol_rel": {"value": 0.01, "units": "ratio"}}, "strata": {"operation": "buffer", "buffer_kind": "cap_style", "trap": true}}
{"case_id": "buffer-005", "operation": "buffer", "split": "test", "prompt": "Buffer the line from longitude 13.40, latitude 52.50 to longitude 13.41, latitude 52.51 (WGS 84) by 20 meters with square caps, computing the buffer in UTM zone 33N (EPSG:32633). Return the polygon in WGS 84 longitude and latitude (OGC:CRS84).", "inputs": {"files": {}, "params": {"geometry": {"type": "LineString", "coordinates": [[13.4, 52.5], [13.41, 52.51]]}, "crs": "EPSG:32633", "distance": 20, "units": "m", "cap_style": "square"}}, "expected": "expected/buffer-005.json", "tolerances": {"tol_m": {"value": 1.0, "units": "m"}, "area_tol_rel": {"value": 0.01, "units": "ratio"}}, "strata": {"operation": "buffer", "buffer_kind": "cap_style", "trap": true}}
{"case_id": "buffer-006", "operation": "buffer", "split": "test", "prompt": "Buffer every site in the layer by 300 meters, computing the buffers in UTM zone 33N (EPSG:32633), and dissolve the overlapping buffers into one geometry. Return it in WGS 84 longitude and latitude (OGC:CRS84).", "inputs": {"files": {"source": "fixtures/buffer_sites.geojson"}, "params": {"crs": "EPSG:32633", "distance": 300, "units": "m", "dissolve": true}}, "expected": "expected/buffer-006.json", "tolerances": {"tol_m": {"value": 3.0, "units": "m"}, "area_tol_rel": {"value": 0.01, "units": "ratio"}}, "strata": {"operation": "buffer", "buffer_kind": "dissolve", "trap": true}}
{"case_id": "buffer-007", "operation": "buffer", "split": "test", "prompt": "Buffer the 200 m by 100 m rectangle in UTM zone 33N (EPSG:32633) inward by 50 international feet (a buffer of -50 ft). Return the result in EPSG:32633.", "inputs": {"files": {}, "params": {"geometry": {"type": "Polygon", "coordinates": [[[390000, 5820000], [390200, 5820000], [390200, 5820100], [390000, 5820100], [390000, 5820000]]]}, "source_crs": "EPSG:32633", "distance": -50, "units": "ft"}}, "expected": "expected/buffer-007.json", "tolerances": {"tol_m": {"value": 0.15, "units": "m"}, "area_tol_rel": {"value": 0.01, "units": "ratio"}}, "strata": {"operation": "buffer", "buffer_kind": "negative_units", "trap": true}}
