{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geoevals.dev/schemas/benchmark.schema.json",
  "schema_version": "1.1.0",
  "title": "GeoEvals benchmark spec",
  "description": "Defines a benchmark's task, inputs, outputs, cases, splits, metrics, tolerances, and provenance. Specs are authored as YAML.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "pillar",
    "task_statement",
    "intended_use",
    "input_schema",
    "output_schema",
    "cases",
    "splits",
    "metrics",
    "tolerances",
    "dataset_manifest",
    "license",
    "provenance",
    "limitations"
  ],
  "allOf": [
    {
      "description": "Every output field of a human_context benchmark must carry an evidence_type.",
      "if": {
        "required": ["pillar"],
        "properties": { "pillar": { "const": "human_context" } }
      },
      "then": {
        "properties": { "output_schema": { "$ref": "#/$defs/humanContextOutputSchema" } }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this benchmark spec schema that the document targets.",
      "const": "1.1.0"
    },
    "id": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "pillar": {
      "description": "Evaluation pillar the benchmark belongs to.",
      "enum": ["perception", "spatial_reasoning", "human_context"]
    },
    "task_statement": { "$ref": "#/$defs/nonEmptyString" },
    "intended_use": { "$ref": "#/$defs/nonEmptyString" },
    "input_schema": {
      "description": "JSON Schema for a case's input.",
      "type": "object"
    },
    "output_schema": {
      "description": "JSON Schema (the output contract) that adapter output must satisfy. Its top-level properties are the output fields; each may carry an evidence_type.",
      "type": "object",
      "properties": {
        "properties": {
          "type": "object",
          "additionalProperties": {
            "properties": { "evidence_type": { "$ref": "#/$defs/evidenceType" } }
          }
        }
      }
    },
    "cases": {
      "description": "Path, or list of paths, to the JSONL case file(s), relative to the spec file.",
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      ]
    },
    "splits": {
      "description": "Named splits of the case set.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/split" }
    },
    "metrics": {
      "description": "Metrics used to score each case, referenced by registered ID and version.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metricRef" }
    },
    "tolerances": {
      "description": "Named default tolerances, each with explicit units.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/tolerance" }
    },
    "dataset_manifest": {
      "description": "Path to the dataset manifest, relative to the spec file.",
      "$ref": "#/$defs/nonEmptyString"
    },
    "license": {
      "description": "License of the benchmark spec and cases (SPDX identifier preferred).",
      "$ref": "#/$defs/nonEmptyString"
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "limitations": {
      "description": "Known limitations of the benchmark.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  },
  "$defs": {
    "evidenceType": {
      "description": "Kind of evidence behind an output value: observed (direct measurement), proxy (derived estimate) or judgment (subjective human rating). See docs/human-context.md.",
      "enum": ["observed", "proxy", "judgment"]
    },
    "humanContextOutputSchema": {
      "required": ["properties"],
      "properties": {
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["evidence_type"]
          }
        }
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "description": "lower_snake_case identifier",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "semver": {
      "description": "semantic version MAJOR.MINOR.PATCH (https://semver.org)",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+([0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*))?$"
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "metricRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semver" },
        "params": { "type": "object" }
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "units"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "units": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "created"],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "created": {
          "description": "date YYYY-MM-DD",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reference_workflow": { "$ref": "#/$defs/nonEmptyString" },
        "notes": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
