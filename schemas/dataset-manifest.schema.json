{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geoevals.dev/schemas/dataset-manifest.schema.json",
  "schema_version": "1.0.0",
  "title": "GeoEvals dataset manifest",
  "description": "Lists every data asset a benchmark uses, with its source, license, checksum, and spatial and temporal metadata. Manifests are authored as YAML, or as JSONL where the first line holds every top-level field except `assets` and each later line holds one asset.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "assets"],
  "properties": {
    "schema_version": {
      "description": "Version of this dataset manifest schema that the document targets.",
      "const": "1.0.0"
    },
    "dataset_id": { "$ref": "#/$defs/identifier" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "assets": {
      "description": "Data assets in the dataset.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "description": "lower_snake_case identifier",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "date": {
      "description": "date YYYY-MM-DD",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "path",
        "access_date",
        "license",
        "attribution",
        "redistributable",
        "sha256",
        "crs",
        "bbox",
        "time_range",
        "processing_steps",
        "split",
        "known_limitations"
      ],
      "allOf": [
        {
          "description": "asset needs at least one of 'source_url' or 'citation'",
          "anyOf": [{ "required": ["source_url"] }, { "required": ["citation"] }]
        }
      ],
      "properties": {
        "asset_id": { "$ref": "#/$defs/identifier" },
        "path": {
          "description": "Local path of the asset file, relative to the manifest file. Assets with redistributable: false must sit in a gitignored path such as data/raw/.",
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_url": {
          "description": "URL with a scheme (https://...)",
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://\\S+$"
        },
        "citation": { "$ref": "#/$defs/nonEmptyString" },
        "access_date": { "$ref": "#/$defs/date" },
        "license": {
          "description": "License of the asset (SPDX identifier preferred).",
          "$ref": "#/$defs/nonEmptyString"
        },
        "attribution": {
          "description": "Attribution text the license requires.",
          "$ref": "#/$defs/nonEmptyString"
        },
        "redistributable": {
          "description": "Whether the license allows the asset to be committed to this repository.",
          "type": "boolean"
        },
        "sha256": {
          "description": "lowercase hex SHA-256 digest (64 characters)",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "crs": {
          "description": "Coordinate reference system of the asset, for example EPSG:4326.",
          "$ref": "#/$defs/nonEmptyString"
        },
        "bbox": {
          "description": "Bounding box [min_x, min_y, max_x, max_y] in the asset CRS.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "time_range": { "$ref": "#/$defs/timeRange" },
        "processing_steps": {
          "description": "Ordered steps applied to the source data; empty when the asset is unmodified.",
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "split": {
          "description": "Benchmark split that uses the asset.",
          "$ref": "#/$defs/identifier"
        },
        "known_limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "timeRange": {
      "description": "Dates the asset's data covers, inclusive.",
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/date" }
      }
    }
  }
}
